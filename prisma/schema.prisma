// This is your Prisma schema file for MongoDB,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "darwin-arm64"]
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  USER
}

model RoleDefinition {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String   @unique
  description String?
  isSystem    Boolean  @default(false)
  status      String   @default("ACTIVE")
  permissions Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  users       User[]
}

model User {
  id                String          @id @default(auto()) @map("_id") @db.ObjectId
  name              String
  username          String?
  email             String          @unique
  phone             String?
  employeeId        String?
  department        String?
  password          String
  role              Role            @default(USER)
  roleTitle         String?         @default("Administrator")
  roleDefinitionId  String?         @db.ObjectId
  roleDefinition    RoleDefinition? @relation(fields: [roleDefinitionId], references: [id])
  permissions       Json?
  isActive          Boolean         @default(true)
  mustResetPassword Boolean         @default(false)
  lastLogin         DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  expenses          Expense[]
}

model CompanySettings {
  id                    String   @id @default(auto()) @map("_id") @db.ObjectId
  businessName          String
  businessAddress       String
  GSTIN                 String?
  state                 String?
  stateCode             String?
  financialYear         String?
  invoicePrefix         String?
  proformaInvoicePrefix String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

enum CustomerType {
  B2B
  B2C
  B2B_EXPORT
}

model Customer {
  id                    String       @id @default(auto()) @map("_id") @db.ObjectId
  customerType          CustomerType
  gstRegistrationStatus String?      @default("REGISTERED")
  legalName             String
  tradeName             String?
  gstin                 String?      @unique
  pan                   String?
  email                 String?
  phone                 String?
  contactPerson         String?
  address               String?
  city                  String?
  state                 String?
  stateCode             String?
  pinCode               String?
  placeOfSupply         String?
  country               String?      @default("India")
  isActive              Boolean      @default(true)
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt
  proformaInvoices      ProformaInvoice[]
  taxInvoices           TaxInvoice[]
}

enum ProductType {
  PRODUCT
  SERVICE
}

model Product {
  id                   String   @id @default(auto()) @map("_id") @db.ObjectId
  name                 String
  description          String?
  type                 ProductType
  hsnSacCode           String
  unit                 String
  sellingPrice         Float
  customPrice          Float?
  purchasePrice        Float?
  gstRate              Float
  cessRate             Float?
  isActive             Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  proformaInvoiceItems ProformaInvoiceItem[]
  expenseItems         ExpenseItem[]
  taxInvoiceItems      TaxInvoiceItem[]
}

model BankAccount {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  accountName   String
  bankName      String
  branch        String?
  accountNumber String
  ifsc          String
  isPrimary     Boolean  @default(false)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

enum ProformaInvoiceStatus {
  DRAFT
  SENT
  ACCEPTED
  CONVERTED
  REJECTED
  EXPIRED
  CANCELLED
}

model ProformaInvoice {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  invoiceNumber   String   @unique
  customerId      String   @db.ObjectId
  customer        Customer @relation(fields: [customerId], references: [id])
  invoiceDate     DateTime @default(now())
  customerType    String?
  financialYear   String?
  status          ProformaInvoiceStatus @default(DRAFT)
  subtotal        Float
  totalDiscount   Float @default(0)
  totalCGST       Float @default(0)
  totalSGST       Float @default(0)
  totalIGST       Float @default(0)
  totalTax        Float @default(0)
  tdsRate         Float @default(0)
  tdsAmount       Float @default(0)
  grossAmount     Float @default(0)
  netAmount       Float @default(0)
  totalAmount     Float
  notes           String?
  isPurchaseOrder Boolean @default(false)
  
  // Bank Account & Snapshot
  bankAccountId        String?  @db.ObjectId
  accountNameSnapshot  String?
  bankNameSnapshot     String?
  branchSnapshot       String?
  accountNumberSnapshot String?
  ifscSnapshot         String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  items           ProformaInvoiceItem[]
}

model ProformaInvoiceItem {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  proformaInvoiceId String   @db.ObjectId
  proformaInvoice   ProformaInvoice @relation(fields: [proformaInvoiceId], references: [id], onDelete: Cascade)
  productId         String   @db.ObjectId
  product           Product  @relation(fields: [productId], references: [id])
  description       String?
  quantity          Float
  unit              String
  unitPrice         Float
  discountPercent   Float @default(0)
  taxableAmount     Float
  isGstEnabled      Boolean @default(true)
  gstRate           Float
  cgstAmount        Float @default(0)
  sgstAmount        Float @default(0)
  igstAmount        Float @default(0)
  totalGST          Float @default(0)
  
  isTdsEnabled      Boolean @default(true)
  tdsRate           Float @default(0)
  tdsAmount         Float @default(0)

  totalAmount       Float
}

enum TaxInvoiceStatus {
  CONFIRMED
  PAID
  PARTIALLY_PAID
  CANCELLED
}

model TaxInvoice {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  invoiceNumber   String   @unique
  sourceProformaId String?  @unique
  
  // Relations
  customerId      String   @db.ObjectId
  customer        Customer @relation(fields: [customerId], references: [id])
  
  // Snapshots
  customerNameSnapshot String?
  businessNameSnapshot String?
  gstinSnapshot        String?
  stateSnapshot        String?
  stateCodeSnapshot    String?
  addressSnapshot      String?

  // Bank Account & Snapshot
  bankAccountId        String?  @db.ObjectId
  accountNameSnapshot  String?
  bankNameSnapshot     String?
  branchSnapshot       String?
  accountNumberSnapshot String?
  ifscSnapshot         String?

  invoiceDate     DateTime @default(now())
  status          TaxInvoiceStatus @default(CONFIRMED)

  subtotal        Float
  totalDiscount   Float @default(0)
  taxableAmount   Float

  totalCGST       Float @default(0)
  totalSGST       Float @default(0)
  totalIGST       Float @default(0)
  totalGST        Float @default(0)

  tdsRate         Float?
  tdsAmount       Float @default(0)

  grossAmount     Float
  netAmount       Float

  notes           String?
  cancellationReason String?
  cancelledAt     DateTime?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  items           TaxInvoiceItem[]
  payments        InvoicePayment[]
}

model InvoicePayment {
  id              String      @id @default(auto()) @map("_id") @db.ObjectId
  taxInvoiceId    String      @db.ObjectId
  taxInvoice      TaxInvoice  @relation(fields: [taxInvoiceId], references: [id], onDelete: Cascade)
  paymentDate     DateTime    @default(now())
  paymentAmount   Float
  isTdsDeducted   Boolean     @default(false)
  tdsRate         Float       @default(0)
  tdsAmount       Float       @default(0)
  bankReceipt     Float
  reference       String?
  remarks         String?
  createdAt       DateTime    @default(now())
}

model TaxInvoiceItem {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId

  taxInvoiceId  String   @db.ObjectId
  taxInvoice    TaxInvoice @relation(fields: [taxInvoiceId], references: [id], onDelete: Cascade)

  productId     String?  @db.ObjectId
  product       Product? @relation(fields: [productId], references: [id])

  // Snapshots
  name          String
  description   String?
  hsnSacCode    String
  
  quantity      Float
  unit          String
  unitPrice     Float

  discountPercent Float @default(0)
  discountAmount  Float @default(0)

  taxableAmount   Float

  gstRate         Float
  cgstRate        Float @default(0)
  cgstAmount      Float @default(0)

  sgstRate        Float @default(0)
  sgstAmount      Float @default(0)

  igstRate        Float @default(0)
  igstAmount      Float @default(0)

  totalGST        Float @default(0)
  totalAmount     Float
}

// ----------------------------------------------------------------------------
// Phase 7: Expense Management
// ----------------------------------------------------------------------------

model ExpenseCategory {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  name            String   @unique
  description     String?
  parentId        String?  @db.ObjectId
  parent          ExpenseCategory? @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children        ExpenseCategory[] @relation("CategoryHierarchy")
  hierarchyLevel  Int      @default(1)
  financialType   String   @default("EXPENSE")
  statementGroup  String?
  isActive        Boolean  @default(true)

  expenses        Expense[] @relation("ExpenseCategory")
  expenseItems    ExpenseItem[] @relation("ExpenseItemCategory")
  vendorDefaults  Vendor[] @relation("VendorDefaultCategory")

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Vendor {
  id                    String   @id @default(auto()) @map("_id") @db.ObjectId
  name                  String
  businessName          String?
  vendorType            String?  @default("B2B")
  gstRegistrationStatus String?  @default("REGISTERED")
  gstin                 String?
  pan                   String?
  email                 String?
  phone                 String?
  contactPerson         String?
  address               String?
  city                  String?
  state                 String?
  stateCode             String?
  country               String?  @default("India")
  defaultCategoryId     String?  @db.ObjectId
  defaultCategory       ExpenseCategory? @relation("VendorDefaultCategory", fields: [defaultCategoryId], references: [id])
  isActive              Boolean  @default(true)

  expenses              Expense[]
  expenseItems          ExpenseItem[]

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

enum ExpenseStatus {
  DRAFT
  APPROVED
  REJECTED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
}

model Expense {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId

  expenseNumber     String   @unique

  expenseDate       DateTime
  description       String?

  vendorId          String?  @db.ObjectId
  vendor            Vendor?  @relation(fields: [vendorId], references: [id])

  categoryId        String?  @db.ObjectId
  category          ExpenseCategory? @relation("ExpenseCategory", fields: [categoryId], references: [id])

  paidBy            String?  @default("COMPANY")
  employeeId        String?  @db.ObjectId
  employee          User?    @relation(fields: [employeeId], references: [id])

  status            ExpenseStatus @default(DRAFT)
  paymentStatus     PaymentStatus @default(UNPAID)

  subtotal          Float
  discountAmount    Float @default(0)
  taxableAmount     Float

  inputCGST         Float @default(0)
  inputSGST         Float @default(0)
  inputIGST         Float @default(0)
  totalInputGST     Float @default(0)

  tdsRate           Float?
  tdsAmount         Float @default(0)

  grossAmount       Float
  netAmount         Float

  notes             String?

  cancellationReason String?
  cancelledAt       DateTime?

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  items             ExpenseItem[]
}

model ExpenseItem {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId

  expenseId       String   @db.ObjectId
  expense         Expense  @relation(fields: [expenseId], references: [id], onDelete: Cascade)

  productId       String?  @db.ObjectId
  product         Product? @relation(fields: [productId], references: [id])

  vendorId        String?  @db.ObjectId
  vendor          Vendor?  @relation(fields: [vendorId], references: [id])

  categoryId      String?  @db.ObjectId
  category        ExpenseCategory? @relation("ExpenseItemCategory", fields: [categoryId], references: [id])

  date            DateTime?

  hsnSacCode      String?

  quantity        Float    @default(1)
  unit            String?

  unitPrice       Float

  gstRate         Float    @default(0)

  taxableAmount   Float

  cgstRate        Float    @default(0)
  cgstAmount      Float    @default(0)

  sgstRate        Float    @default(0)
  sgstAmount      Float    @default(0)

  igstRate        Float    @default(0)
  igstAmount      Float    @default(0)

  totalGST        Float    @default(0)

  tdsRate         Float    @default(0)
  tdsAmount       Float    @default(0)

  totalAmount     Float
}

// ----------------------------------------------------------------------------
// Phase 8: Financial Ledger
// ----------------------------------------------------------------------------

enum FinancialTransactionType {
  REVENUE
  EXPENSE
}

model FinancialTransaction {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId

  transactionNumber String @unique

  type            FinancialTransactionType

  transactionDate DateTime

  description     String

  amount          Float

  taxableAmount   Float    @default(0)

  totalGST        Float    @default(0)

  tdsAmount       Float    @default(0)

  netAmount       Float

  paymentStatus   PaymentStatus @default(UNPAID)

  sourceType      String
  sourceId        String

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model BankTransfer {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  date        DateTime @default(now())
  fromAccount String
  toAccount   String
  amount      Float
  reference   String?
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model OpeningBalance {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  financialYear String
  position      String
  amount        Float
  type          String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([financialYear, position])
}
