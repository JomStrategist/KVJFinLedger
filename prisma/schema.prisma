// This is your Prisma schema file for MongoDB,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "darwin-arm64"]
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  USER
}

model RoleDefinition {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String   @unique
  description String?
  isSystem    Boolean  @default(false)
  status      String   @default("ACTIVE")
  permissions Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  users       User[]
}

model User {
  id                String          @id @default(auto()) @map("_id") @db.ObjectId
  name              String
  username          String?
  email             String          @unique
  phone             String?
  employeeId        String?
  department        String?
  password          String
  role              Role            @default(USER)
  roleTitle         String?         @default("Administrator")
  roleDefinitionId  String?         @db.ObjectId
  roleDefinition    RoleDefinition? @relation(fields: [roleDefinitionId], references: [id])
  permissions       Json?
  isActive          Boolean         @default(true)
  mustResetPassword Boolean         @default(false)
  lastLogin         DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
}

model Employee {
  id            String            @id @default(auto()) @map("_id") @db.ObjectId
  employeeCode  String?           @unique
  name          String
  email         String?
  phone         String?
  department    String?
  designation   String?
  pan           String?
  salary        Float?            @default(0)
  isActive      Boolean           @default(true)
  bankAccountNo String?
  bankIfsc      String?
  bankName      String?
  uan           String?
  pfNumber      String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  expenses      Expense[]
  advances      EmployeeAdvance[]
}

model EmployeeAdvance {
  id             String    @id @default(auto()) @map("_id") @db.ObjectId
  advanceNumber  String?   @unique
  employeeId     String    @db.ObjectId
  employee       Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  advanceDate    DateTime  @default(now())
  amount         Float
  purpose        String?
  repaidAmount   Float     @default(0)
  balanceAmount  Float     @default(0)
  status         String    @default("ACTIVE") // ACTIVE, REPAID, DEDUCTED
  deductionMonth String?
  paymentMode    String?   @default("BANK")
  reference      String?
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}


model CompanySettings {
  id                    String   @id @default(auto()) @map("_id") @db.ObjectId
  businessName          String
  businessAddress       String
  GSTIN                 String?
  state                 String?
  stateCode             String?
  financialYear         String?
  invoicePrefix         String?
  proformaInvoicePrefix String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

enum CustomerType {
  B2B
  B2C
  B2B_EXPORT
}

model Customer {
  id                    String       @id @default(auto()) @map("_id") @db.ObjectId
  customerType          CustomerType
  gstRegistrationStatus String?      @default("REGISTERED")
  legalName             String
  tradeName             String?
  gstin                 String?      @unique
  pan                   String?
  email                 String?
  phone                 String?
  contactPerson         String?
  address               String?
  city                  String?
  state                 String?
  stateCode             String?
  pinCode               String?
  placeOfSupply         String?
  country               String?      @default("India")
  isActive              Boolean      @default(true)
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt
  proformaInvoices      ProformaInvoice[]
  taxInvoices           TaxInvoice[]
}

enum ProductType {
  PRODUCT
  SERVICE
}

model Product {
  id                   String   @id @default(auto()) @map("_id") @db.ObjectId
  name                 String
  description          String?
  type                 ProductType
  hsnSacCode           String
  unit                 String
  sellingPrice         Float
  customPrice          Float?
  purchasePrice        Float?
  gstRate              Float
  cessRate             Float?
  isActive             Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  proformaInvoiceItems ProformaInvoiceItem[]
  expenseItems         ExpenseItem[]
  taxInvoiceItems      TaxInvoiceItem[]
}

model BankAccount {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  accountName   String
  bankName      String
  branch        String?
  accountNumber String
  ifsc          String
  isPrimary     Boolean  @default(false)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

enum ProformaInvoiceStatus {
  DRAFT
  SENT
  ACCEPTED
  CONVERTED
  REJECTED
  EXPIRED
  CANCELLED
}

model ProformaInvoice {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  invoiceNumber   String   @unique
  customerId      String   @db.ObjectId
  customer        Customer @relation(fields: [customerId], references: [id])
  invoiceDate     DateTime @default(now())
  customerType    String?
  financialYear   String?
  status          ProformaInvoiceStatus @default(DRAFT)
  subtotal        Float
  totalDiscount   Float @default(0)
  totalCGST       Float @default(0)
  totalSGST       Float @default(0)
  totalIGST       Float @default(0)
  totalTax        Float @default(0)
  tdsRate         Float @default(0)
  tdsAmount       Float @default(0)
  grossAmount     Float @default(0)
  netAmount       Float @default(0)
  totalAmount     Float
  notes           String?
  isPurchaseOrder Boolean @default(false)
  poNumber        String?
  
  // Bank Account & Snapshot
  bankAccountId        String?  @db.ObjectId
  accountNameSnapshot  String?
  bankNameSnapshot     String?
  branchSnapshot       String?
  accountNumberSnapshot String?
  ifscSnapshot         String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  items           ProformaInvoiceItem[]
}

model ProformaInvoiceItem {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  proformaInvoiceId String   @db.ObjectId
  proformaInvoice   ProformaInvoice @relation(fields: [proformaInvoiceId], references: [id], onDelete: Cascade)
  productId         String   @db.ObjectId
  product           Product  @relation(fields: [productId], references: [id])
  description       String?
  quantity          Float
  unit              String
  unitPrice         Float
  discountPercent   Float @default(0)
  taxableAmount     Float
  isGstEnabled      Boolean @default(true)
  gstRate           Float
  cgstAmount        Float @default(0)
  sgstAmount        Float @default(0)
  igstAmount        Float @default(0)
  totalGST          Float @default(0)
  
  isTdsEnabled      Boolean @default(true)
  tdsRate           Float @default(0)
  tdsAmount         Float @default(0)

  incomeCategoryId       String?          @db.ObjectId
  incomeCategory         ExpenseCategory? @relation("ProformaIncomeCategory", fields: [incomeCategoryId], references: [id])
  categoryNameSnapshot   String?
  categoryCodeSnapshot   String?
  statementGroupSnapshot String?
  financialTypeSnapshot  String?

  totalAmount       Float
}

enum TaxInvoiceStatus {
  CONFIRMED
  PAID
  PARTIALLY_PAID
  CANCELLED
}

model TaxInvoice {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  invoiceNumber   String   @unique
  sourceProformaId String?  @unique
  poNumber        String?
  
  // Relations
  customerId      String   @db.ObjectId
  customer        Customer @relation(fields: [customerId], references: [id])
  
  // Snapshots
  customerNameSnapshot String?
  businessNameSnapshot String?
  gstinSnapshot        String?
  stateSnapshot        String?
  stateCodeSnapshot    String?
  addressSnapshot      String?

  // Bank Account & Snapshot
  bankAccountId        String?  @db.ObjectId
  accountNameSnapshot  String?
  bankNameSnapshot     String?
  branchSnapshot       String?
  accountNumberSnapshot String?
  ifscSnapshot         String?

  invoiceDate     DateTime @default(now())
  status          TaxInvoiceStatus @default(CONFIRMED)

  subtotal        Float
  totalDiscount   Float @default(0)
  taxableAmount   Float

  totalCGST       Float @default(0)
  totalSGST       Float @default(0)
  totalIGST       Float @default(0)
  totalGST        Float @default(0)

  tdsRate         Float?
  tdsAmount       Float @default(0)

  grossAmount     Float
  netAmount       Float

  // GST Remittance to Government tracking
  gstPaidToGovt   Boolean   @default(false)
  gstPaidDate     DateTime?
  gstChallanRef   String?   // CPIN / BSR Code / Challan reference

  notes           String?
  cancellationReason String?
  cancelledAt     DateTime?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  items           TaxInvoiceItem[]
  payments        InvoicePayment[]
}

model InvoicePayment {
  id              String      @id @default(auto()) @map("_id") @db.ObjectId
  taxInvoiceId    String      @db.ObjectId
  taxInvoice      TaxInvoice  @relation(fields: [taxInvoiceId], references: [id], onDelete: Cascade)
  paymentDate     DateTime    @default(now())
  paymentAmount   Float
  isTdsDeducted   Boolean     @default(false)
  tdsRate         Float       @default(0)
  tdsAmount       Float       @default(0)
  bankReceipt     Float
  reference       String?
  remarks         String?
  isCancelled     Boolean?    @default(false)
  cancelledAt     DateTime?
  cancellationReason String?
  advanceAmount   Float?      @default(0)
  isOnAccount     Boolean?    @default(false)
  createdAt       DateTime    @default(now())
}

model TaxInvoiceItem {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId

  taxInvoiceId  String   @db.ObjectId
  taxInvoice    TaxInvoice @relation(fields: [taxInvoiceId], references: [id], onDelete: Cascade)

  productId     String?  @db.ObjectId
  product       Product? @relation(fields: [productId], references: [id])

  // Snapshots
  name          String
  description   String?
  hsnSacCode    String
  
  quantity      Float
  unit          String
  unitPrice     Float

  discountPercent Float @default(0)
  discountAmount  Float @default(0)

  taxableAmount   Float

  gstRate         Float
  cgstRate        Float @default(0)
  cgstAmount      Float @default(0)

  sgstRate        Float @default(0)
  sgstAmount      Float @default(0)

  igstRate        Float @default(0)
  igstAmount      Float @default(0)

  incomeCategoryId       String?          @db.ObjectId
  incomeCategory         ExpenseCategory? @relation("TaxInvoiceIncomeCategory", fields: [incomeCategoryId], references: [id])
  categoryNameSnapshot   String?
  categoryCodeSnapshot   String?
  statementGroupSnapshot String?
  financialTypeSnapshot  String?

  totalGST        Float @default(0)
  totalAmount     Float
}

// ----------------------------------------------------------------------------
// Phase 7: Chart of Accounts & Accounting Classification Masters
// ----------------------------------------------------------------------------

model FinancialType {
  id                 String   @id @default(auto()) @map("_id") @db.ObjectId
  code               String   @unique // INCOME, EXPENSE, ASSET, LIABILITY, EQUITY
  name               String   // Income, Expense, Asset, Liability, Equity
  financialStatement String   // Profit & Loss vs Balance Sheet
  normalBalance      String   // Debit vs Credit
  description        String?
  sortOrder          Int      @default(0)
  isActive           Boolean  @default(true)

  statementGroups    FinancialStatementGroup[]
  accountNatures     AccountNature[]
  categories         ExpenseCategory[]

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model FinancialStatementGroup {
  id              String        @id @default(auto()) @map("_id") @db.ObjectId
  financialTypeId String        @db.ObjectId
  financialType   FinancialType @relation(fields: [financialTypeId], references: [id])
  name            String
  code            String?
  description     String?
  sortOrder       Int           @default(0)
  isActive        Boolean       @default(true)

  categories      ExpenseCategory[]

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model AccountNature {
  id              String        @id @default(auto()) @map("_id") @db.ObjectId
  financialTypeId String        @db.ObjectId
  financialType   FinancialType @relation(fields: [financialTypeId], references: [id])
  name            String
  code            String?
  description     String?
  sortOrder       Int           @default(0)
  isActive        Boolean       @default(true)

  categories      ExpenseCategory[]

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model ExpenseCategory {
  id                      String                   @id @default(auto()) @map("_id") @db.ObjectId
  name                    String                   @unique
  code                    String?
  description             String?
  parentId                String?                  @db.ObjectId
  parent                  ExpenseCategory?         @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children                ExpenseCategory[]        @relation("CategoryHierarchy")
  hierarchyLevel          Int                      @default(1)

  financialTypeId         String?                  @db.ObjectId
  financialTypeRef        FinancialType?           @relation(fields: [financialTypeId], references: [id])
  financialType           String                   @default("EXPENSE")

  statementGroupId        String?                  @db.ObjectId
  statementGroupRef       FinancialStatementGroup? @relation(fields: [statementGroupId], references: [id])
  statementGroup          String?

  accountNatureId         String?                  @db.ObjectId
  accountNatureRef        AccountNature?           @relation(fields: [accountNatureId], references: [id])
  accountNature           String?

  financialStatement      String?
  normalBalance           String?
  isActive                Boolean                  @default(true)

  expenses                Expense[]                @relation("ExpenseCategory")
  expenseItems            ExpenseItem[]            @relation("ExpenseItemCategory")
  proformaItems           ProformaInvoiceItem[]    @relation("ProformaIncomeCategory")
  taxInvoiceItems         TaxInvoiceItem[]         @relation("TaxInvoiceIncomeCategory")

  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
}

model Vendor {
  id                    String   @id @default(auto()) @map("_id") @db.ObjectId
  name                  String
  businessName          String?
  vendorType            String?  @default("B2B")
  gstRegistrationStatus String?  @default("REGISTERED")
  gstin                 String?
  pan                   String?
  email                 String?
  phone                 String?
  contactPerson         String?
  address               String?
  city                  String?
  state                 String?
  stateCode             String?
  country               String?  @default("India")
  isActive              Boolean  @default(true)

  expenses              Expense[]
  expenseItems          ExpenseItem[]

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

enum ExpenseStatus {
  DRAFT
  APPROVED
  REJECTED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
}

model Expense {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId

  expenseNumber     String   @unique

  expenseDate       DateTime
  description       String?

  vendorId          String?  @db.ObjectId
  vendor            Vendor?  @relation(fields: [vendorId], references: [id])

  categoryId        String?  @db.ObjectId
  category          ExpenseCategory? @relation("ExpenseCategory", fields: [categoryId], references: [id])

  paidBy            String?  @default("COMPANY")
  employeeId        String?  @db.ObjectId
  employee          Employee? @relation(fields: [employeeId], references: [id])

  status            ExpenseStatus @default(DRAFT)
  paymentStatus     PaymentStatus @default(UNPAID)
  paidAmount        Float?        @default(0)
  balancePayable    Float?        @default(0)
  advanceAmount     Float?        @default(0)

  subtotal          Float
  discountAmount    Float @default(0)
  taxableAmount     Float

  inputCGST         Float @default(0)
  inputSGST         Float @default(0)
  inputIGST         Float @default(0)
  totalInputGST     Float @default(0)

  isItcEligible     Boolean       @default(true)
  itcIneligibleReason String?

  tdsRate           Float?
  tdsAmount         Float @default(0)
  tdsPaymentStatus  String?       @default("UNPAID") // "UNPAID", "PAID"
  tdsPaidDate       DateTime?
  tdsChallanNumber  String?       // Challan ITNS 281 / BSR Code / CIN
  tdsSection        String?       @default("194J")   // 194C, 194J, 194I, etc.

  grossAmount       Float
  netAmount         Float

  isAsset           Boolean       @default(false)
  assetType         String?
  depreciationRate  Float?        @default(0)

  notes             String?

  cancellationReason String?
  cancelledAt       DateTime?

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  items             ExpenseItem[]
  depreciations     AssetDepreciation[]
  disposal          AssetDisposal?
}

model ExpenseItem {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId

  expenseId       String   @db.ObjectId
  expense         Expense  @relation(fields: [expenseId], references: [id], onDelete: Cascade)

  productId       String?  @db.ObjectId
  product         Product? @relation(fields: [productId], references: [id])

  vendorId        String?  @db.ObjectId
  vendor          Vendor?  @relation(fields: [vendorId], references: [id])

  categoryId      String?  @db.ObjectId
  category        ExpenseCategory? @relation("ExpenseItemCategory", fields: [categoryId], references: [id])

  categoryNameSnapshot   String?
  categoryCodeSnapshot   String?
  statementGroupSnapshot String?
  financialTypeSnapshot  String?

  date            DateTime?

  hsnSacCode      String?

  quantity        Float    @default(1)
  unit            String?

  unitPrice       Float

  gstRate         Float    @default(0)

  taxableAmount   Float

  cgstRate        Float    @default(0)
  cgstAmount      Float    @default(0)

  sgstRate        Float    @default(0)
  sgstAmount      Float    @default(0)

  igstRate        Float    @default(0)
  igstAmount      Float    @default(0)

  totalGST        Float    @default(0)

  tdsRate         Float    @default(0)
  tdsAmount       Float    @default(0)

  isAsset         Boolean  @default(false)
  depreciationRate Float?  @default(0)
  isItcEligible   Boolean? @default(true)

  totalAmount     Float
}

// ----------------------------------------------------------------------------
// Phase 8: Financial Ledger
// ----------------------------------------------------------------------------

enum FinancialTransactionType {
  REVENUE
  EXPENSE
}

model FinancialTransaction {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId

  transactionNumber String @unique

  type            FinancialTransactionType

  transactionDate DateTime

  description     String

  amount          Float

  taxableAmount   Float    @default(0)

  totalGST        Float    @default(0)

  tdsAmount       Float    @default(0)

  netAmount       Float

  paymentStatus   PaymentStatus @default(UNPAID)
  paidAmount      Float?        @default(0)

  sourceType      String
  sourceId        String

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model BankTransfer {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  date        DateTime @default(now())
  fromAccount String
  toAccount   String
  amount      Float
  reference   String?
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model OpeningBalance {
  id                String    @id @default(auto()) @map("_id") @db.ObjectId
  financialYear     String
  position          String
  amount            Float
  type              String
  customerId        String?   @db.ObjectId
  vendorId          String?   @db.ObjectId
  invoiceNumber     String?
  invoiceDate       DateTime?
  billNumber        String?
  billDate          DateTime?
  outstandingAmount Float?
  notes             String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model GstFiling {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  financialYear   String
  returnType      String    @default("GSTR-3B") // GSTR-3B, GSTR-1, GSTR-9
  period          String?   @default("Annual")
  filingDate      DateTime  @default(now())
  arn             String?   // Application Reference Number (e.g. AA3204260012345)
  challanNumber   String?   // CPIN / CIN / Bank Challan Reference

  taxableTurnover Float     @default(0)
  totalOutputGST  Float     @default(0)
  totalITC        Float     @default(0)
  netTaxPaid      Float     @default(0)

  status          String    @default("FILED") // FILED, PENDING
  paymentMode     String    @default("BANK")
  bankAccount     String?
  notes           String?

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([financialYear, returnType])
}

model TdsDeposit {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  financialYear   String    // e.g. "FY 2026–27"
  quarter         String?   @default("Annual")
  section         String?   @default("194J") // 194J, 194C, 194I, etc.
  challanNumber   String    // ITNS 281 Challan / BSR Code / CIN
  bsrCode         String?   // 7-digit branch code
  challanSerial   String?   // 5-digit serial number
  depositDate     DateTime  @default(now())
  amountPaid      Float     @default(0)
  status          String    @default("PAID")
  bankAccount     String?   @default("Primary Bank Account")
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model AssetDepreciation {
  id                  String    @id @default(auto()) @map("_id") @db.ObjectId
  expenseId           String    @db.ObjectId
  expense             Expense   @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  financialYear       String    // e.g. "FY 2026–27"
  method              String    @default("WDV") // "WDV" or "SLM"
  rate                Float     @default(0)     // e.g. 40.0, 15.0
  depreciationAmount  Float     // Exact written-off amount for this period
  effectiveDate       DateTime  @default(now())
  remarks             String?   // Audit / Board resolution remarks
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@unique([expenseId, financialYear])
}

model AssetDisposal {
  id                      String    @id @default(auto()) @map("_id") @db.ObjectId
  expenseId               String    @unique @db.ObjectId
  expense                 Expense   @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  disposalDate            DateTime  @default(now())
  saleProceeds            Float     @default(0)
  grossCost               Float
  accumulatedDepreciation Float     @default(0)
  netBookValue            Float     @default(0)
  gainOrLoss              Float     @default(0)
  bankAccountId           String?   @db.ObjectId
  buyerName               String?
  notes                   String?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
}

model Loan {
  id                String          @id @default(auto()) @map("_id") @db.ObjectId
  loanNumber        String          @unique
  lenderName        String
  loanType          String          @default("TERM_LOAN") // TERM_LOAN, SECURED, UNSECURED, OVERDRAFT
  principalAmount   Float
  interestRate      Float?          @default(0)
  disbursementDate  DateTime        @default(now())
  bankAccountId     String?         @db.ObjectId
  status            String          @default("ACTIVE") // ACTIVE, CLOSED
  notes             String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  repayments        LoanRepayment[]
}

model LoanRepayment {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  loanId          String   @db.ObjectId
  loan            Loan     @relation(fields: [loanId], references: [id], onDelete: Cascade)
  paymentDate     DateTime @default(now())
  totalAmount     Float
  principalAmount Float
  interestAmount  Float
  bankAccountId   String?  @db.ObjectId
  reference       String?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model BankStatementImport {
  id              String              @id @default(auto()) @map("_id") @db.ObjectId
  bankAccountId   String              @db.ObjectId
  statementDate   DateTime            @default(now())
  fileName        String
  closingBalance  Float?              @default(0)
  totalRecords    Int                 @default(0)
  status          String              @default("IN_PROGRESS") // IN_PROGRESS, RECONCILED
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  lines           BankStatementLine[]
}

model BankStatementLine {
  id              String              @id @default(auto()) @map("_id") @db.ObjectId
  importId        String              @db.ObjectId
  import          BankStatementImport @relation(fields: [importId], references: [id], onDelete: Cascade)
  transactionDate DateTime
  description     String
  referenceNo     String?
  withdrawal      Float               @default(0)
  deposit         Float               @default(0)
  balance         Float?
  isReconciled    Boolean             @default(false)
  matchedType     String?
  matchedId       String?
  matchedNotes    String?
  reconciledAt    DateTime?
  createdAt       DateTime            @default(now())
}

model GstSettlement {
  id                String    @id @default(auto()) @map("_id") @db.ObjectId
  settlementNumber  String?   @unique
  returnPeriod      String    // e.g. "09/2026" or "Q2 FY 2026-27"
  paymentDate       DateTime  @default(now())
  cgstPaid          Float     @default(0)
  sgstPaid          Float     @default(0)
  igstPaid          Float     @default(0)
  totalPaid         Float     @default(0)
  itcCgstUtilized   Float     @default(0)
  itcSgstUtilized   Float     @default(0)
  itcIgstUtilized   Float     @default(0)
  bankAccountId     String?   @db.ObjectId
  challanRef        String?
  notes             String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}


